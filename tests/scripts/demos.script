# TempleOS demos that exercise the hardware paths Phase 6 cares about.
# Starter script: timings are guesses until tuned on a real run.
wait 60
type n
wait 3
type n
wait 5
# ScrnMemory reads and writes VGA memory directly (LBts with only plane 2
# write-enabled): the case the VGA fast path must get right.
type \#include "::/Demo/Lectures/ScrnMemory.HC";\n
wait 5
screenshot 10-scrnmemory
key spc
wait 3
# Hanoi: graphics, sound (Beep), then PressAKey.
type \#include "::/Demo/Graphics/Hanoi.HC";\n
wait 20
screenshot 20-hanoi
key spc
wait 3
# Palette: DAC programming.
type \#include "::/Demo/Graphics/Palette.HC";\n
wait 5
screenshot 30-palette
key spc
wait 3
screenshot 99-end
