# TempleOS demos that exercise the hardware paths Phase 6 cares about.
# Waits are guest time on both machines (qemu_trace.py waits on QEMU's
# -icount clock).
wait 60
type n
wait 3
type n
wait 5
# ScrnMemory reads and writes VGA memory directly (LBts, which WHPX's
# emulator can't do, with single planes write-enabled): the case the VGA
# fast path must get right. It draws, then Busy-waits 4 s with nothing else
# running, so the screenshot 2 s in is its drawing alone. It doesn't wait
# for a key.
type \#include "::/Demo/Lectures/ScrnMemory.HC";\n
wait 2
screenshot 10-scrnmemory
wait 6
# Hanoi: graphics, sound (Beep), then PressAKey.
type \#include "::/Demo/Graphics/Hanoi.HC";\n
wait 20
screenshot 20-hanoi
key spc
wait 3
# Palette: DAC programming.
type \#include "::/Demo/Graphics/Palette.HC";\n
wait 5
screenshot 30-palette
key spc
wait 3
screenshot 99-end
